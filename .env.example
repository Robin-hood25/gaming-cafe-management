# ==============================================================================
# GAMING CAFE MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project URL and Public Anonymous API Key
# Found in: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service Role Key for server-side administrative functions
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Timezone and Locale Defaults
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY_SYMBOL=₹

